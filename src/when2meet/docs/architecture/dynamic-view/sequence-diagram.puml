@startuml sequence-diagram
' When2Meet — Dynamic view (sequence diagram)
' Scenario: a participant opens a shared event link and submits availability.
' This is the core availability-collection flow and exercises every backend component.

skinparam monochrome false
skinparam shadowing false
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #2C3E50
  ParticipantBorderColor #2C3E50
  ParticipantBackgroundColor #ECF0F1
}

title When2Meet — Sequence Diagram: Open Shared Event and Submit Availability

actor "Participant\n(Browser)" as U
participant "Frontend\n(React)" as FE
participant "When2Meet API\n(FastAPI)" as API
participant "Auth Dependency\n(INH_TOKEN_AUTH)" as Auth
participant "Events Repository" as Repo
database "MongoDB\nevents" as DB
participant "InNoHassle\nAccounts API" as Acc

== Open shared event ==

U -> FE : open /when2meet/{slug}
FE -> Acc : redirect for SSO login
Acc -> FE : Bearer JWT

FE -> API : GET /events/{slug}\nAuthorization: Bearer <JWT>
activate API
API -> Auth : resolve token
activate Auth
Auth -> Acc : verify JWT against JWKS
Acc -> Auth : valid + innohassle_id
Auth -> API : auth.innohassle_id
deactivate Auth

API -> Repo : read_by_ref(slug)
activate Repo
Repo -> DB : find_one(slug)
DB -> Repo : Event document
Repo -> API : Event | None
deactivate Repo

alt event not found
  API -> FE : 404 Not Found
  FE -> U : "Event not found" state
else event found
  API -> Acc : get_users(participant user_ids)
  Acc -> API : user profiles (email, name, telegram)
  API -> FE : 200 EventView\n(enriched participants)
  FE -> U : render availability grid\n+ heatmap
end
deactivate API

== Submit / edit availability ==

U -> FE : select free slots, click Save
FE -> API : PUT /events/{slug}/participants\n{ availability: [...] }\nAuthorization: Bearer <JWT>
activate API
API -> Auth : resolve token
Auth -> API : auth.innohassle_id

API -> Repo : read_by_ref(slug)
Repo -> DB : find_one(slug)
DB -> Repo : Event
Repo -> API : Event

API -> API : validate slots ⊆ event.slots\nelse 400 Bad Request

API -> Repo : update_participant(event, availability, user_id)
activate Repo
Repo -> DB : upsert participant + event.save()
DB -> Repo : ack
Repo -> API : updated Event
deactivate Repo

API -> Acc : get_users(participant user_ids)
Acc -> API : enriched profiles
API -> FE : 200 EventView
deactivate API
FE -> U : updated heatmap + max-intersection highlight
@enduml
