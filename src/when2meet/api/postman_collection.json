{
  "info": {
    "name": "InNoHassle When2Meet API",
    "description": "Service foundation for When2Meet designed during SWP course. MVP v0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v0",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Get My Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ""
              ]
            },
            "description": "Get events owned by the authenticated user."
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Event Name\",\n  \"description\": \"Event description goes here\",\n  \"slots\": [\n    \"2026-06-26T17:36:00Z\"\n  ],\n  \"timezone\": \"UTC\",\n  \"specific_time\": false,\n  \"time_range\": {\n    \"start\": \"09:00\",\n    \"end\": \"18:00\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ""
              ]
            },
            "description": "Create a new event with time slots."
          }
        },
        {
          "name": "Get Participating Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/participating",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "participating"
              ]
            },
            "description": "Get events where the authenticated user is a participant."
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/:event_ref",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ":event_ref"
              ],
              "variable": [
                {
                  "key": "event_ref",
                  "value": "example_event_slug_or_id"
                }
              ]
            },
            "description": "Get event details and participants' availability."
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Event Name\",\n  \"description\": \"Updated description\",\n  \"slots\": [\n    \"2026-06-26T17:36:00Z\",\n    \"2026-06-27T10:00:00Z\"\n  ],\n  \"timezone\": \"UTC\",\n  \"specific_time\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/:event_ref",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ":event_ref"
              ],
              "variable": [
                {
                  "key": "event_ref",
                  "value": "example_event_slug_or_id"
                }
              ]
            },
            "description": "Update event details (owner only)."
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/:event_ref",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ":event_ref"
              ],
              "variable": [
                {
                  "key": "event_ref",
                  "value": "example_event_slug_or_id"
                }
              ]
            },
            "description": "Delete an event (owner only)."
          }
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availability\": [\n    \"2026-06-26T17:36:00Z\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/:event_ref/participants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ":event_ref",
                "participants"
              ],
              "variable": [
                {
                  "key": "event_ref",
                  "value": "example_event_slug_or_id"
                }
              ]
            },
            "description": "Add or update a participant's availability for an event."
          }
        },
        {
          "name": "Delete Participant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/:event_ref/participants/:user_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ":event_ref",
                "participants",
                ":user_id"
              ],
              "variable": [
                {
                  "key": "event_ref",
                  "value": "example_event_slug_or_id"
                },
                {
                  "key": "user_id",
                  "value": "example_user_id"
                }
              ]
            },
            "description": "Remove a participant from an event (owner or the participant themselves)."
          }
        }
      ]
    }
  ]
}
